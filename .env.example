MSANII_ENV=development                 # production enables Secure cookies + HSTS and requires the Fernet key
MSANII_DB=./data/msanii.db

# Supabase PostgreSQL Connection (optional in development, recommended in production)
# Get from Supabase Project Settings > Database > Connection string (URI)
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# SUPABASE_URL=https://[project-ref].supabase.co
# SUPABASE_KEY=eyJ...

MSANII_FERNET_KEY=                     # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MSANII_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
MSANII_CONTACT=kimothojackson1125@gmail.com # used in the User-Agent sent to MusicBrainz
MSANII_PROXIES=0                       # 1 only when behind exactly one trusted reverse proxy
MSANII_UPLOAD_DIR=./data/uploads
MSANII_ADMIN_EMAIL=kimothojackson1125@gmail.com # admin email notification recipient
MSANII_NOTIFICATION_EMAIL=kimothojackson1125@gmail.com
MSANII_BASE_URL=http://localhost:5000  # used in invite and approval e-mails
MSANII_SMTP_HOST=                      # optional: set to live SMTP server (e.g. smtp.gmail.com or SendGrid)
MSANII_SMTP_PORT=587
MSANII_SMTP_USER=
MSANII_SMTP_PASSWORD=
MSANII_SMTP_FROM=msanii@soundscout.ai
