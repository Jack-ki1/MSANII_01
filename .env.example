# --- required in production (Vercel project settings > Environment Variables, or your container env) ---
MSANII_ENV=production                  # enables Secure cookies + HSTS. Vercel production/preview deployments are treated as production automatically
MSANII_FERNET_KEY=                     # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  (encrypts provider credentials + MFA secrets; keep it secret and stable)
SUPABASE_DB_URL=                       # Supabase > Project Settings > Database > Connection string > URI (use the pooler, port 6543). Required on Vercel.
MSANII_ALLOWED_ORIGINS=https://your-app.vercel.app
MSANII_BASE_URL=https://your-app.vercel.app    # used in invite e-mails

# --- first administrator (only used while the users table is empty; then remove the password from the environment) ---
MSANII_ADMIN_EMAIL=
MSANII_ADMIN_PASSWORD=                 # 10+ characters with letters and numbers

# --- optional ---
MSANII_NOTIFICATION_EMAIL=             # who is told about new access requests (defaults to MSANII_ADMIN_EMAIL)
MSANII_CONTACT=                        # contact address placed in the User-Agent sent to MusicBrainz
MSANII_PROXIES=0                       # 1 when behind exactly one trusted reverse proxy (automatic on Vercel)
MSANII_PG_POOL=5                       # max PostgreSQL connections per process
MSANII_SMTP_HOST=
MSANII_SMTP_PORT=587
MSANII_SMTP_USER=
MSANII_SMTP_PASSWORD=
MSANII_SMTP_FROM=

# --- local development only ---
# MSANII_ENV=development
# MSANII_DB=./data/msanii.db            # SQLite is used when SUPABASE_DB_URL is not set
# MSANII_UPLOAD_DIR=./data/uploads
